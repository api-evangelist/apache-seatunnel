            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit a new SeaTunnel data sync job for execution."
        },
        {
          "info": {
            "name": "Apache SeaTunnel Get Job",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://seatunnel.example.com/hazelcast/rest/maps/job/:jobId",
            "params": [
              {
                "name": "jobId",
                "value": "",
